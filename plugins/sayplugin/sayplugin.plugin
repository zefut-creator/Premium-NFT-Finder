            Switch(key="dashboard_emoji", text="Иконки в меню", default=True,
                   subtext="Показывать значки рядом с разделами.", icon="msg_stickers"),
            Switch(key="dashboard_intro", text="Описание на главном экране", default=True,
                   icon="msg_info"),
            Header(text="02 · Интеллект и память"),
            Switch(key="archive_enabled", text="Личный архив", default=True,
                   subtext="Сохраняй только сообщения, которые выбрал сам.", icon="msg_saved"),
            Selector(key="archive_limit", text="Размер архива", default=1,
