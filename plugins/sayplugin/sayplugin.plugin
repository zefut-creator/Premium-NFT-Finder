class ThemeColorHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            if not self.plugin.get_setting("telegram_theme_enabled", False):
                return
            args = param.args
            if args is None or len(args) < 1:
                return
            key_name = self.plugin.theme_key_ids.get(int(args[0]))
            if not key_name:
                return
            index = int(self.plugin.get_setting("telegram_palette", 0) or 0)
            palette = PALETTES[max(0, min(index, len(PALETTES) - 1))]
            value = palette.get(key_name)
            if value:
                color = int(value, 16)
                if color >= 0x80000000:
                    color -= 0x100000000
                param.setResult(color)
        except Exception:
            return


class SayPlugin(BasePlugin):
    def on_plugin_load(self):
        self.add_on_send_message_hook()
        self.add_menu_item(MenuItemData(
            menu_type=MenuItemType.MAIN_MENU, text="SayPlugin",
            on_click=self.open_dashboard, icon="msg_tools",
            subtext="Персональный центр Telegram", priority=10,
        ))
        self.add_menu_item(MenuItemData(
            menu_type=MenuItemType.CHAT_ACTION_MENU, text="SayPlugin",
            on_click=self.open_dashboard, icon="msg_settings",
            subtext="Инструменты текущего чата", priority=10,
        ))
        self.add_menu_item(MenuItemData(
            menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,
            text="Сохранить в SayPlugin", on_click=self.save_selected_message,
            icon="msg_saved", subtext="В личный архив", priority=10,
        ))
        self.theme_hooks = []
        self.theme_key_ids = {}
        if self.get_setting("telegram_theme_enabled", False):
            self.install_theme_hooks()
        self.logger.info("SayPlugin 0.4.0 loaded")

    def install_theme_hooks(self):
        try:
            theme_class = find_class("org.telegram.ui.ActionBar.Theme")
            self.theme_key_ids = {}
            if not theme_class:
                self.logger.warning("Theme class unavailable; color customization disabled.")
                return
            for name in PALETTES[0].keys():
                try:
                    field = theme_class.getField(name)
                    self.theme_key_ids[int(field.get(None))] = name
                except Exception:
                    continue
            hooks = self.hook_all_methods(theme_class, "getColor", ThemeColorHook(self))
            self.theme_hooks = hooks or []
            self.logger.info("Theme color hook registered; recognized keys: %s", len(self.theme_key_ids))
            if not self.theme_hooks:
                self.logger.warning("Theme.getColor hooks were not registered.")
        except Exception:
            self.theme_key_ids = {}
            self.logger.exception("Could not initialize optional Telegram color customization.")

    def on_theme_toggle(self, enabled: bool):
        if enabled:
            if not getattr(self, "theme_hooks", None):
                self.install_theme_hooks()
            BulletinHelper.show_info("Цветовая тема Telegram включена, если текущая сборка поддерживает нужные ключи.")
        else:
            for hook in getattr(self, "theme_hooks", []) or []:
                try:
                    self.unhook_method(hook)
                except Exception:
                    pass
            self.theme_hooks = []
            BulletinHelper.show_info("Переопределение цветов Telegram выключено.")

