__app_version__ = ">=12.5.1"
__sdk_version__ = ">=1.4.4.3"
__category__ = ["appearance", "chats", "tools"]

DEFAULT_SHORTCUTS = """;пр=Привет, как дела?
;спс=Большое спасибо!
;пж=Пожалуйста!
;сори=Извини, пожалуйста.
;имя=Меня зовут
;дата={date}
;время={time}"""
MAX_ARCHIVE_ITEMS = 300
MAX_TEXT = 12000
SHORTCUT_RE = re.compile(r"(?<!\\S)(;[A-Za-zА-Яа-яЁё0-9_]{1,32})(?!\\S)")


def parse_shortcuts(raw: str) -> Dict[str, str]:
    result = {}
    for line in (raw or "").splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        key, value = key.strip(), value.strip()
        if re.fullmatch(r";[A-Za-zА-Яа-яЁё0-9_]{1,32}", key) and value:
            result[key] = value[:2000]
    return result


def safe_json_list(raw: Any) -> List[dict]:
    try:
        value = json.loads(raw) if isinstance(raw, str) else raw
        return [item for item in value if isinstance(item, dict)] if isinstance(value, list) else []
    except Exception:
        return []


def clean_text(value: str) -> str:
    value = re.sub(r"[ \\t]+", " ", value or "")
    value = re.sub(r" *\\n *", "\\n", value)
    value = re.sub(r"\\n{3,}", "\\n\\n", value)
    return value.strip()


class SayPlugin(BasePlugin):
    def on_plugin_load(self):
        self.add_on_send_message_hook()
        self.add_menu_item(MenuItemData(
            menu_type=MenuItemType.MAIN_MENU, text="SayPlugin",
            on_click=self.open_dashboard, icon="msg_tools",
            subtext="Персональный центр Telegram", priority=10,
        ))
        self.add_menu_item(MenuItemData(
            menu_type=MenuItemType.CHAT_ACTION_MENU, text="SayPlugin",
            on_click=self.open_dashboard, icon="msg_settings",
            subtext="Инструменты текущего чата", priority=10,
        ))
        self.add_menu_item(MenuItemData(
            menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,
            text="Сохранить в SayPlugin", on_click=self.save_selected_message,
            icon="msg_saved", subtext="В личный архив", priority=10,
        ))
        self.logger.info("SayPlugin 0.2.0 loaded")

