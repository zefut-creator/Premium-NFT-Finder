                   subtext="Команды преобразуют текст перед отправкой.", icon="msg_command"),
            EditText(key="templates", hint=";ключ=текст шаблона",
                     default=";встреча=Здравствуйте! Предлагаю обсудить детали.\n;занят=Сейчас занят, отвечу позже.",
                     multiline=True, max_length=MAX_TEXT),
            Switch(key="signature_enabled", text="Подпись в конце сообщения", default=False,
                   subtext="Добавляется только к обычному тексту.", icon="msg_edit"),
            EditText(key="signature", hint="Текст подписи", default="", multiline=False, max_length=160),
            Text(text="Без автодействий", subtext="Нет фоновой рассылки и самостоятельной отправки сообщений."),
