            EditText(key="shortcuts", hint=";ключ=полный текст (по одной строке)", default=DEFAULT_SHORTCUTS, multiline=True, max_length=MAX_TEXT),
            Switch(key="clean_spaces", text="Убирать лишние пробелы", default=False, icon="msg_format"),
            Switch(key="capitalize_first", text="Заглавная буква в начале", default=False, icon="msg_text"),
