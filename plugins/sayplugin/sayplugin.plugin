            EditText(key="shortcuts", hint=";ключ=полный текст (по одной строке)", default=DEFAULT_SHORTCUTS,
                     multiline=True, max_length=MAX_TEXT),
            Switch(key="clean_spaces", text="Убирать лишние пробелы", default=False,
                   subtext="Схлопывать повторные пробелы и лишние пустые строки.", icon="msg_format"),
            Switch(key="capitalize_first", text="Заглавная буква в начале", default=False,
                   subtext="Автоматически делать первую букву сообщения заглавной.", icon="msg_text"),
            Switch(key="signature_enabled", text="Подпись в конце сообщения", default=False,
                   subtext="Выключено по умолчанию. Добавляется только к твоим обычным текстовым сообщениям.", icon="msg_edit"),
