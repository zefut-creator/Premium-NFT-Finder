class NativeChatTabsHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            self.plugin.ensure_native_chat_tabs(param.thisObject)
        except Exception:
            self.plugin.logger.exception("Could not prepare native chat-list tabs.")


class NativeChatUnreadHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            args = param.args
            if args is None or len(args) < 1:
                return
            event_id = int(args[0])
            notification_class = find_class("org.telegram.messenger.NotificationCenter")
            if not notification_class:
                return
            watched = (
                int(notification_class.getField("dialogsUnreadCounterChanged").get(None)),
                int(notification_class.getField("dialogsNeedReload").get(None)),
            )
            if event_id in watched:
                self.plugin.refresh_native_chat_tab_counts(param.thisObject)
        except Exception:
            return


class SayPlugin(BasePlugin):
    def on_plugin_load(self):
        self.add_on_send_message_hook()
        self.add_menu_item(MenuItemData(
            menu_type=MenuItemType.MAIN_MENU, text="SayPlugin",
            on_click=self.open_dashboard, icon="msg_tools",
            subtext="Персональный центр Telegram", priority=10,
        ))
        self.add_menu_item(MenuItemData(
            menu_type=MenuItemType.CHAT_ACTION_MENU, text="SayPlugin",
            on_click=self.open_dashboard, icon="msg_settings",
            subtext="Инструменты текущего чата", priority=10,
        ))
        self.add_menu_item(MenuItemData(
            menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,
            text="Сохранить в SayPlugin", on_click=self.save_selected_message,
            icon="msg_saved", subtext="В личный архив", priority=10,
        ))
                self.theme_key_ids = {}
        self.native_chat_tabs_hooks = []
        if self.get_setting("telegram_theme_enabled", False):
            self.prepare_theme_palette()
        self.install_native_chat_tabs_hooks()
        self.logger.info("SayPlugin 0.5.1 loaded")

    def prepare_theme_palette(self):
        """Prepare native Theme.setColor access; no method hooks are installed."""
        try:
            theme_class = find_class("org.telegram.ui.ActionBar.Theme")
            self.theme_key_ids = {}
            self.theme_class = theme_class
                        if not theme_class:
                self.logger.warning("Theme class unavailable; color customization disabled.")
                return
            for name in set(PALETTES[0].keys()) | set(PALETTE_EXTRA[0].keys()):
                try:
                    field = theme_class.getField(name)
                    self.theme_key_ids[int(field.get(None))] = name
                except Exception:
                    continue
            if not self.theme_key_ids:
                self.logger.warning("No compatible Theme color keys were found.")
                return
            self.logger.info("Native Theme.setColor ready; recognized keys: %s", len(self.theme_key_ids))
        except Exception:
            self.theme_key_ids = {}
            self.theme_class = None
            self.logger.exception("Could not initialize native Telegram color customization.")


    # ---------- Native AyuGram chat-list filters ----------
    NATIVE_CHAT_FILTERS = (
        (900101, "Личка", "👤", ("DIALOG_FILTER_FLAG_CONTACTS", "DIALOG_FILTER_FLAG_NON_CONTACTS")),
        (900102, "Чаты", "👥", ("DIALOG_FILTER_FLAG_GROUPS",)),
        (900103, "Каналы", "📢", ("DIALOG_FILTER_FLAG_CHANNELS",)),
        (900104, "Боты", "🤖", ("DIALOG_FILTER_FLAG_BOTS",)),
    )

    def install_native_chat_tabs_hooks(self):
        try:
            dialogs_class = find_class("org.telegram.ui.DialogsActivity")
            if not dialogs_class:
                self.logger.warning("DialogsActivity unavailable; native chat tabs are disabled.")
                return
            self.native_chat_tabs_hooks = []
            self.native_chat_tabs_hooks += self.hook_all_methods(
                dialogs_class, "updateFilterTabs", NativeChatTabsHook(self)) or []
            self.native_chat_tabs_hooks += self.hook_all_methods(
                dialogs_class, "didReceivedNotification", NativeChatUnreadHook(self)) or []
            self.logger.info("Native chat-tab hooks registered: %s", len(self.native_chat_tabs_hooks))
        except Exception:
            self.logger.exception("Could not register native chat-tab hooks.")

    def _native_filter_flags(self, controller, names):
        controller_class = find_class("org.telegram.messenger.MessagesController")
        flags = 0
        for name in names:
            try:
                flags |= int(controller_class.getField(name).get(None))
            except Exception:
                pass
        try:
            flags |= int(controller_class.getField("DIALOG_FILTER_FLAG_EXCLUDE_ARCHIVED").get(None))
        except Exception:
            pass
        return flags

    def _update_native_filter_unread(self, activity, controller, filters):
        try:
            account = activity.getAccountInstance()
            dialogs = controller.getAllDialogs()
            for filter_id, name, emoji, flag_names in self.NATIVE_CHAT_FILTERS:
                target = None
                for index in range(int(filters.size())):
                    item = filters.get(index)
                    if int(item.id) == filter_id:
                        target = item
                        break
                if target is None:
                    continue
                total = 0
                for dialog in dialogs:
                    try:
                        if target.includesDialog(account, int(dialog.id), dialog):
                            total += max(0, int(controller.getDialogUnreadCount(dialog)))
                    except Exception:
                        continue
                target.unreadCount = total
                target.pendingUnreadCount = 0
            tabs = get_private_field(activity, "filterTabsView")
            if tabs is not None:
                tabs.invalidate()
                try:
                    tabs.getTabsContainer().invalidateViews()
                except Exception:
                    pass
        except Exception:
            self.logger.exception("Could not update native chat-tab unread totals.")

    def ensure_native_chat_tabs(self, activity):
        if not self.get_setting("native_chat_tabs_enabled", True):
            return
        try:
            controller = activity.getMessagesController()
            filters = get_private_field(controller, "dialogFilters")
            if filters is None or get_private_field(controller, "frozenDialogFilters") is not None:
                return
            default_index = -1
            for index in range(int(filters.size())):
                if int(filters.get(index).id) == 0:
                    default_index = index
                    break
            if default_index < 0:
                return
            filter_class = find_class("org.telegram.messenger.MessagesController$DialogFilter")
            if not filter_class:
                return
            insert_at = default_index + 1
            for filter_id, name, emoji, flag_names in self.NATIVE_CHAT_FILTERS:
                target = None
                for index in range(int(filters.size())):
                    item = filters.get(index)
                    if int(item.id) == filter_id:
                        target = item
                        filters.remove(index)
                        break
                if target is None:
                    target = filter_class()
                target.id = filter_id
                target.name = name
                target.emoticon = emoji
                target.flags = self._native_filter_flags(controller, flag_names)
                target.order = insert_at
                target.locked = False
                filters.add(insert_at, target)
                # DialogsAdapter reads DialogFilter.dialogs, not the controller's
                # allDialogs list. Populate the native filtered lists explicitly.
                controller.updateFilterDialogs(target)
                insert_at += 1
            self._update_native_filter_unread(activity, controller, filters)
        except Exception:
            self.logger.exception("Native chat-tab injection failed.")

    def refresh_native_chat_tab_counts(self, activity):
        try:
            self.ensure_native_chat_tabs(activity)
        except Exception:
            return

    def on_native_chat_tabs_toggle(self, enabled):
        try:
            fragment = get_last_fragment()
            if fragment is None:
                return
            controller = fragment.getMessagesController()
            filters = get_private_field(controller, "dialogFilters")
            if filters is None:
                return
            ids = {item[0] for item in self.NATIVE_CHAT_FILTERS}
            if not enabled:
                for index in range(int(filters.size()) - 1, -1, -1):
                    if int(filters.get(index).id) in ids:
                        filters.remove(index)
            else:
                self.ensure_native_chat_tabs(fragment)
            notification_class = find_class("org.telegram.messenger.NotificationCenter")
            event = int(notification_class.getField("dialogFiltersUpdated").get(None))
            notification_class.getInstance(fragment.getCurrentAccount()).postNotificationName(event)
        except Exception:
            self.logger.exception("Could not toggle native chat tabs.")

    def _reload_native_theme(self):
        theme_class = getattr(self, "theme_class", None) or find_class("org.telegram.ui.ActionBar.Theme")
        if not theme_class:
            raise RuntimeError("Класс Theme недоступен")
        try:
            current_theme = theme_class.getCurrentTheme()
            theme_class.saveCurrentTheme(current_theme, False, False, False)
        except Exception:
            self.logger.warning("Theme colors changed in memory; saving current theme was unavailable.")
        notification_class = find_class("org.telegram.messenger.NotificationCenter")
        if not notification_class:
            raise RuntimeError("NotificationCenter недоступен")
        event = int(notification_class.getField("reloadInterface").get(None))
        notification_class.getGlobalInstance().postNotificationName(event)

    def apply_theme_palette(self):
        if not self.get_setting("telegram_theme_enabled", False):
            BulletinHelper.show_info("Сначала включи экспериментальную цветовую тему.")
            return
        try:
            if not getattr(self, "theme_key_ids", None):
                self.prepare_theme_palette()
            theme_class = getattr(self, "theme_class", None)
            if not theme_class or not self.theme_key_ids:
                raise RuntimeError("В этой сборке не найдены поддерживаемые цвета Theme")
            index = max(0, min(int(self.get_setting("telegram_palette", 0) or 0), len(PALETTES) - 1))
            palette = PALETTES[index]
            extra = PALETTE_EXTRA[index]
            applied = 0
            for key_id, key_name in self.theme_key_ids.items():
                value = palette.get(key_name) or extra.get(key_name)
                if not value:
                    continue
                color = int(value, 16)
                if color >= 0x80000000:
                    color -= 0x100000000
                theme_class.setColor(int(key_id), int(color), False)
                applied += 1
            if applied < 5:
                raise RuntimeError("Применилось слишком мало цветов: " + str(applied))
            self._reload_native_theme()
            BulletinHelper.show_success("Палитра применена: " + str(applied) + " цветов.")
        except Exception as error:
            self.logger.exception("Could not apply native Telegram color palette.")
            BulletinHelper.show_error("Ошибка цветовой темы: " + str(error)[:140])

    def on_palette_change(self, value):
        try:
            self.set_setting("telegram_palette", int(value))
        except Exception:
            pass
        if self.get_setting("telegram_theme_enabled", False):
            self.apply_theme_palette()

    def on_theme_toggle(self, enabled: bool):
        if enabled:
            if not getattr(self, "theme_key_ids", None):
                self.prepare_theme_palette()
            if not getattr(self, "theme_key_ids", None):
                self.set_setting("telegram_theme_enabled", False)
                BulletinHelper.show_error("Цветовая тема не поддерживается этой сборкой.")
                return
            self.apply_theme_palette()
        else:
            try:
                if not getattr(self, "theme_key_ids", None):
                    self.prepare_theme_palette()
                theme_class = getattr(self, "theme_class", None)
                if not theme_class or not self.theme_key_ids:
                    raise RuntimeError("Theme недоступна для сброса цветов")
                for key_id in self.theme_key_ids:
                    theme_class.setColor(int(key_id), 0, True)
                self._reload_native_theme()
                BulletinHelper.show_info("Цвета Telegram возвращены к исходной теме.")
            except Exception as error:
                self.logger.exception("Could not reset native Telegram palette.")
                BulletinHelper.show_error("Не удалось сбросить тему: " + str(error)[:140])

    # ---------- Settings ----------
    def create_settings(self) -> List[Any]:
        return [
            Header(text="SayPlugin · Центр управления"),
            Text(text="Модульная панель", subtext="Открой раздел, чтобы увидеть настройки и действия."),
            Text(text="🎨 Внешний вид Telegram", subtext="Цветовые палитры и оформление панели.", icon="msg_theme", create_sub_fragment=self._appearance_settings),
            Text(text="🧠 Интеллект и память", subtext="Личный архив, просмотр и очистка.", icon="msg_saved", create_sub_fragment=self._memory_settings),
            Text(text="✍️ Работа с сообщениями", subtext="Автосокращения и обработка текста.", icon="msg_edit", create_sub_fragment=self._message_settings),
            Text(text="⚡ Автоматизация", subtext="Шаблоны, команды и подпись.", icon="msg_command", create_sub_fragment=self._automation_settings),
            Text(text="🧰 Инструменты", subtext="Справка и доступные текстовые команды.", icon="msg_tools", create_sub_fragment=self._tools_settings),
            Text(text="🧪 Лаборатория и диагностика", subtext="Состояние модулей и информация о сборке.", icon="msg_info", create_sub_fragment=self._diagnostics_settings),
        ]

    def _appearance_settings(self) -> List[Any]:
        return [
            Header(text="Внешний вид Telegram"),
            Switch(key="native_chat_tabs_enabled", text="Вкладки списка чатов",
                   default=True, subtext="Личка, чаты, каналы и боты — встроенные фильтры AyuGram с суммой непрочитанных сообщений.",
                   icon="msg_folders", on_change=self.on_native_chat_tabs_toggle),
            Switch(key="telegram_theme_enabled", text="Экспериментальная цветовая тема", default=False,
                   subtext="Только распознанные цвета. Может не поддерживаться отдельными сборками AyuGram.",
                   icon="msg_theme", on_change=self.on_theme_toggle),
            Selector(key="telegram_palette", text="Цветовая палитра", default=0,
                     items=["Океан", "Мята", "Роза", "Фиолетовый", "Графит"], icon="msg_color",
                     on_change=self.on_palette_change),
            Text(text="Применить палитру Telegram", subtext="Обновить интерфейс после выбора цвета.",
                 icon="msg_theme", on_click=lambda view: self.apply_theme_palette()),
            Divider(),
            Header(text="Оформление SayPlugin"),
            Selector(key="dashboard_density", text="Плотность меню", default=1,
                     items=["Компактная", "Обычная", "Подробная"], icon="msg_list"),
            Switch(key="dashboard_emoji", text="Иконки в меню", default=True, icon="msg_stickers"),
            Switch(key="dashboard_intro", text="Описание на главном экране", default=True, icon="msg_info"),
            Text(text="Ограничения оформления", subtext="Шрифты, фоновые изображения и расположение штатных элементов AyuGram пока не меняются."),
        ]

    def _memory_settings(self) -> List[Any]:
        return [
            Header(text="Личный архив"),
            Switch(key="archive_enabled", text="Включить архив", default=True,
                   subtext="Сохраняются только сообщения, которые ты выбрал вручную.", icon="msg_saved"),
            Selector(key="archive_limit", text="Максимум записей", default=1,
                     items=["100 записей", "300 записей", "500 записей"], icon="msg_storage"),
            Text(text="Открыть мой архив", icon="msg_saved", on_click=lambda view: self.show_archive()),
            Text(text="Очистить архив", icon="msg_delete", red=True, on_click=lambda view: self._confirm_clear_archive_from_settings()),
            Text(text="Поиск по архиву", subtext="Команда .sayfind слово открывает локальные результаты и не отправляет их в чат.", icon="msg_search"),
        ]

