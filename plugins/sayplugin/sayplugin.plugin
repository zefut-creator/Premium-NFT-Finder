            Text(text=".sayhelp", subtext="Справка по командам."),
            Text(text=".saydate / .saytime", subtext="Подставить текущую дату или время."),
            Text(text=".sayupper / .saylower", subtext="Изменить регистр текста."),
            Text(text=".saytitle", subtext="Сделать первые буквы слов заглавными."),
            Text(text=".sayclean", subtext="Убрать повторные пробелы и лишние строки."),
            Text(text=".sayreverse", subtext="Перевернуть текст."),
            Text(text=".sayquote / .saybullets", subtext="Оформить цитату или маркированный список."),
            Text(text=".saylen", subtext="Посчитать символы, слова и строки."),
            Divider(),
