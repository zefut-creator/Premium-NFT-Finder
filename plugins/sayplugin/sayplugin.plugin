    def _confirm_clear_archive_from_settings(self):
        fragment = get_last_fragment()
        activity = fragment.getParentActivity() if fragment else None
        if not activity:
            BulletinHelper.show_error("Окно Telegram недоступно.")
            return
        builder = AlertDialogBuilder(activity)
        builder.set_title("Очистить личный архив?")
        builder.set_message("Все сохранённые записи будут удалены.")
        def clear(b, w):
            self.set_setting("archive_json", "[]")
            b.dismiss()
            BulletinHelper.show_success("Архив очищен.")
        builder.set_positive_button("Очистить", clear)
        builder.set_negative_button("Отмена", lambda b, w: b.dismiss())
        builder.show()

    # ---------- Outgoing text engine ----------
    def on_send_message_hook(self, account: int, params: Any) -> HookResult:
        message = getattr(params, "message", None)
        if not isinstance(message, str) or not message.strip():
            return HookResult()
        raw = message
        lowered = raw.strip().lower()

        if lowered == ".sayarchive":
            run_on_ui_thread(self.show_archive)
            return HookResult(strategy=HookStrategy.CANCEL)
        if lowered == ".валюты":
            self.show_currency_list_async()
            return HookResult(strategy=HookStrategy.CANCEL)
        if lowered.startswith(".валюта "):
            self.convert_currency_async(raw.strip()[8:].strip())
            return HookResult(strategy=HookStrategy.CANCEL)
        if lowered.startswith(".sayfind "):
            query = raw.strip()[9:].strip()
            run_on_ui_thread(lambda: self.show_archive_search(query))
            return HookResult(strategy=HookStrategy.CANCEL)

        if self.get_setting("macros_enabled", True):
            command_result = self.run_text_command(raw)
            if command_result is not None:
                params.message = command_result
                return HookResult(strategy=HookStrategy.MODIFY, params=params)

        updated = raw
        if self.get_setting("shortcuts_enabled", True):
            shortcuts = parse_shortcuts(self.get_setting("shortcuts", DEFAULT_SHORTCUTS))
            shortcuts.update(parse_shortcuts(self.get_setting("templates", "")))
            now = datetime.now()
            variables = {"{date}": now.strftime("%d.%m.%Y"), "{time}": now.strftime("%H:%M")}
            def replace_match(match):
                value = shortcuts.get(match.group(1))
                if value is None:
                    return match.group(1)
                for marker, replacement in variables.items():
                    value = value.replace(marker, replacement)
                return value
            updated = SHORTCUT_RE.sub(replace_match, updated)

        if self.get_setting("clean_spaces", False):
            updated = clean_text(updated)
        if self.get_setting("capitalize_first", False) and updated:
            for index, char in enumerate(updated):
                if char.isalpha():
                    updated = updated[:index] + char.upper() + updated[index + 1:]
                    break

        if self.get_setting("signature_enabled", False):
            signature = str(self.get_setting("signature", "") or "").strip()
            if signature and not updated.startswith(".say") and not updated.endswith(signature):
                updated = updated.rstrip() + "\n" + signature

        if updated != raw:
            params.message = updated
            return HookResult(strategy=HookStrategy.MODIFY, params=params)
        return HookResult()

    def _currency_json(self, url: str):
        request = urllib.request.Request(url, headers={"User-Agent": "SayPlugin/0.4"})
        with urllib.request.urlopen(request, timeout=7) as response:
            return json.loads(response.read().decode("utf-8"))

    def show_currency_list_async(self):
        def worker():
            try:
                data = self._currency_json("https://open.er-api.com/v6/latest/USD")
                if data.get("result") != "success":
                    raise ValueError("Источник курсов временно недоступен.")
                rates = data.get("rates", {})
                labels = [("KZT", "Тенге"), ("RUB", "Рубли"), ("USD", "Доллары"),
                          ("UAH", "Гривны"), ("EUR", "Евро"), ("GBP", "Фунты"),
                          ("CNY", "Юани"), ("TRY", "Лиры")]
                lines = ["Справочные курсы относительно USD:"]
                for code, name in labels:
                    if code == "USD":
                        lines.append(name + " (USD): 1")
                    elif code in rates:
                        lines.append(f"{name} ({code}): {float(rates[code]):.5g}")
                lines += ["", "Доступные коды фиатных валют: " + ", ".join(sorted(rates.keys())),
                          "Криптовалюты: BTC — Bitcoin; GRAM — Gram (бывший TON).",
                          "Обновление фиатных курсов: " + str(data.get("time_last_update_utc", "неизвестно"))]
                body = "\n".join(lines)
            except Exception as error:
                body = "Не удалось загрузить курсы. Проверь подключение и попробуй позже.\n" + str(error)[:160]
            run_on_ui_thread(lambda: self._show_text_dialog("SayPlugin · Валюты", body))
        threading.Thread(target=worker, daemon=True).start()

    def convert_currency_async(self, expression: str):
        aliases = {
            "тенге":"KZT", "тг":"KZT", "kzt":"KZT",
            "рубли":"RUB", "рубль":"RUB", "руб":"RUB", "rub":"RUB",
            "доллары":"USD", "доллар":"USD", "баксы":"USD", "usd":"USD",
            "гривны":"UAH", "гривна":"UAH", "uah":"UAH",
            "евро":"EUR", "eur":"EUR", "фунты":"GBP", "gbp":"GBP",
            "юани":"CNY", "cny":"CNY", "лиры":"TRY", "try":"TRY",
            "биткоин":"BTC", "биткойн":"BTC", "btc":"BTC",
            "грам":"GRAM", "gram":"GRAM", "ton":"GRAM", "toncoin":"GRAM",
        }
        parts = expression.lower().replace("=", " ").split()
        try:
            if len(parts) != 3:
                raise ValueError("Формат: .валюта 2000 KZT RUB или .валюта тенге 2000 = рубли")
            if re.fullmatch(r"[0-9]+(?:[.,][0-9]+)?", parts[0]):
                amount = float(parts[0].replace(",", "."))
                source, target = parts[1].upper(), parts[2].upper()
            elif re.fullmatch(r"[0-9]+(?:[.,][0-9]+)?", parts[1]):
                source, target = aliases.get(parts[0]), aliases.get(parts[2])
                amount = float(parts[1].replace(",", "."))
            else:
                raise ValueError("Не понял сумму. Пример: .валюта 2000 KZT RUB")
            source, target = aliases.get(source, source), aliases.get(target, target)
            if amount <= 0 or not source or not target:
                raise ValueError("Проверь сумму и обозначения валют.")
        except Exception as error:
            self._show_text_dialog("Конвертер валют", str(error))
            return

        def worker():
            try:
                fiat = self._currency_json("https://open.er-api.com/v6/latest/USD")
                if fiat.get("result") != "success":
                    raise ValueError("Нет ответа от источника фиатных курсов.")
                rates = fiat.get("rates", {})
                crypto_ids = {"BTC":"bitcoin", "GRAM":"the-open-network"}
                crypto = {}
                if source in crypto_ids or target in crypto_ids:
                    ids = ",".join(sorted(set(crypto_ids.values())))
                    url = "https://api.coingecko.com/api/v3/simple/price?" + urllib.parse.urlencode(
                        {"ids": ids, "vs_currencies": "usd"})
                    crypto = self._currency_json(url)
                def usd_price(code):
                    if code in crypto_ids:
                        price = crypto.get(crypto_ids[code], {}).get("usd")
                        if price is None:
                            raise ValueError("Нет актуального курса " + code + ".")
                        return float(price)
                    if code == "USD":
                        return 1.0
                    if code not in rates:
                        raise ValueError("Валюта " + code + " не поддерживается.")
                    return 1.0 / float(rates[code])
                converted = amount * usd_price(source) / usd_price(target)
                body = (f"{amount:g} {source} ≈ {converted:,.8g} {target}\n\n"
                        "Ориентировочный расчёт по рыночному курсу, не гарантирует сумму обмена. "
                        "Фиат: open.er-api.com; криптовалюта: CoinGecko.")
            except Exception as error:
                body = "Не удалось выполнить конвертацию: " + str(error)[:200]
            run_on_ui_thread(lambda: self._show_text_dialog("Конвертер валют", body))
        threading.Thread(target=worker, daemon=True).start()

    def run_text_command(self, raw: str):
        text = raw.strip()
        lowered = text.lower()
        if lowered == ".sayhelp":
            return self.help_text()
        if lowered == ".saydate":
            return datetime.now().strftime("%d.%m.%Y")
        if lowered == ".saytime":
            return datetime.now().strftime("%H:%M")
        if lowered.startswith(".sayupper "):
            return text[10:].upper()
        if lowered.startswith(".saylower "):
            return text[10:].lower()
        if lowered.startswith(".saytitle "):
            return text[10:].title()
        if lowered.startswith(".sayclean "):
            return clean_text(text[10:])
        if lowered.startswith(".sayreverse "):
            return text[12:][::-1]
        if lowered.startswith(".sayquote "):
            return "\n".join("> " + line for line in text[10:].splitlines())
        if lowered.startswith(".saybullets "):
            lines = [line.strip() for line in text[12:].splitlines() if line.strip()]
            return "\n".join("• " + line.lstrip("•-— ").strip() for line in lines)
        if lowered.startswith(".saylen "):
            body = text[8:]
            return f"Символов: {len(body)} · Слов: {len(body.split())} · Строк: {len(body.splitlines())}"
        if lowered.startswith(".saydate "):
            return text[9:].replace("{date}", datetime.now().strftime("%d.%m.%Y"))
        return None

    # ---------- Dashboard ----------
    def open_dashboard(self, context: Dict[str, Any]):
        fragment = get_last_fragment()
        activity = fragment.getParentActivity() if fragment else None
        if not activity:
            BulletinHelper.show_error("Окно Telegram недоступно.")
            return
        emoji = self.get_setting("dashboard_emoji", True)
        items = [
            (("📚 " if emoji else "") + "Мой архив"),
            (("⌨️ " if emoji else "") + "Текст и шаблоны"),
            (("⚡ " if emoji else "") + "Автоматизация"),
            (("🎨 " if emoji else "") + "Внешний вид SayPlugin"),
            (("🧰 " if emoji else "") + "Инструменты"),
            (("🧪 " if emoji else "") + "Лаборатория"),
            (("📊 " if emoji else "") + "Статус и диагностика"),
        ]
        density_value = self.get_setting("dashboard_density", 1)
        density = int(1 if density_value is None else density_value)
        if density == 0:
            items = items[:5]
        def on_item_click(builder, which):
            builder.dismiss()
            actions = [self.show_archive, self.show_text_tools, self.show_automation,
                       self.show_appearance, self.show_utilities, self.show_lab,
                       self.show_module_status]
            if 0 <= which < len(actions):
                actions[which]()
        builder = AlertDialogBuilder(activity)
        builder.set_title("SayPlugin · Центр")
        if self.get_setting("dashboard_intro", True):
            builder.set_message("Настрой Telegram под себя: сообщения, память, автоматизация и оформление панели плагина.")
        builder.set_items(items, on_item_click)
        builder.set_negative_button("Закрыть", lambda b, w: b.dismiss())
        builder.show()

    def _show_text_dialog(self, title: str, body: str):
        fragment = get_last_fragment()
        activity = fragment.getParentActivity() if fragment else None
        if not activity:
            BulletinHelper.show_error("Окно Telegram недоступно.")
            return
        builder = AlertDialogBuilder(activity)
        builder.set_title(title)
        builder.set_message((body or "Пока пусто.")[:MAX_TEXT])
        builder.set_positive_button("Готово", lambda b, w: b.dismiss())
        builder.show()

    def show_archive(self):
        if not self.get_setting("archive_enabled", True):
            self._show_text_dialog("Мой архив", "Архив отключён в настройках SayPlugin.")
            return
        archive = safe_json_list(self.get_setting("archive_json", "[]"))
        if not archive:
            self._show_text_dialog("Мой архив", "Пока пусто. Выбери текстовое сообщение → «Сохранить в SayPlugin».")
            return
        fragment = get_last_fragment()
        activity = fragment.getParentActivity() if fragment else None
        if not activity:
            BulletinHelper.show_error("Окно Telegram недоступно.")
            return
        labels = [f"{i + 1}. {row.get('date', 'Без даты')} — {str(row.get('text', '')).replace(chr(10), ' ')[:65]}"
                  for i, row in enumerate(archive)]
        def on_item_click(builder, which):
            builder.dismiss()
            if 0 <= which < len(archive):
                row = archive[which]
                self._show_text_dialog(row.get("date", "Запись"), row.get("text", ""))
        builder = AlertDialogBuilder(activity)
        builder.set_title(f"Мой архив · {len(archive)}")
        builder.set_items(labels, on_item_click)
        builder.set_negative_button("Закрыть", lambda b, w: b.dismiss())
        builder.set_neutral_button("Очистить", lambda b, w: self.confirm_clear_archive(b))
        builder.show()

    def show_archive_search(self, query: str):
        if not self.get_setting("archive_enabled", True):
            self._show_text_dialog("Поиск по архиву", "Личный архив отключён.")
            return
        query = (query or "").strip().lower()
        if not query:
            self._show_text_dialog("Поиск по архиву", "Напиши команду .sayfind слово для поиска.")
            return
        rows = safe_json_list(self.get_setting("archive_json", "[]"))
        matches = [row for row in rows if query in str(row.get("text", "")).lower()]
        if not matches:
            self._show_text_dialog("Поиск по архиву", "Совпадений не найдено.")
            return
        body = "\n\n".join(
            str(row.get("date", "Без даты")) + "\n" + str(row.get("text", ""))[:500]
            for row in matches[:12]
        )
        self._show_text_dialog(f"Найдено: {len(matches)}", body)

    def confirm_clear_archive(self, parent):
        parent.dismiss()
        fragment = get_last_fragment()
        activity = fragment.getParentActivity() if fragment else None
        if not activity:
            return
        builder = AlertDialogBuilder(activity)
        builder.set_title("Очистить архив?")
        builder.set_message("Все сохранённые записи SayPlugin будут удалены. Это действие нельзя отменить.")
        def clear(b, w):
            self.set_setting("archive_json", "[]")
            b.dismiss()
            BulletinHelper.show_info("Личный архив очищен.")
        builder.set_positive_button("Очистить", clear)
        builder.set_negative_button("Отмена", lambda b, w: b.dismiss())
        builder.show()

    def save_selected_message(self, context: Dict[str, Any]):
        if not self.get_setting("archive_enabled", True):
            BulletinHelper.show_info("Включи личный архив в настройках SayPlugin.")
            return
        message = context.get("message")
        if message is None:
            BulletinHelper.show_error("Не удалось получить сообщение.")
            return
        text = getattr(message, "messageText", None)
        if not isinstance(text, str) or not text.strip():
            BulletinHelper.show_info("В сообщении нет текста для сохранения.")
            return
        archive = safe_json_list(self.get_setting("archive_json", "[]"))
        try:
            message_id = int(message.getId())
        except Exception:
            message_id = 0
        try:
            dialog_id = int(context.get("dialog_id") or 0)
        except Exception:
            dialog_id = 0
        if any(row.get("message_id") == message_id and row.get("dialog_id") == dialog_id for row in archive):
            BulletinHelper.show_info("Это сообщение уже есть в архиве.")
            return
        archive.insert(0, {"text": text[:4000], "date": datetime.now().strftime("%d.%m.%Y %H:%M"),
                           "message_id": message_id, "dialog_id": dialog_id, "favorite": False})
        limits = [100, 300, 500]
        limit_value = self.get_setting("archive_limit", 1)
        limit_index = int(1 if limit_value is None else limit_value)
        limit = limits[max(0, min(limit_index, 2))]
        self.set_setting("archive_json", json.dumps(archive[:limit], ensure_ascii=False))
        BulletinHelper.show_info("Сохранено в личный архив SayPlugin.")

    # ---------- Module pages ----------
    def show_text_tools(self):
        self._show_text_dialog("Текст и шаблоны",
            "Автосокращения: ;пр, ;спс, ;пж, ;дата, ;время и собственные ключи.\n\n"
            "Команды:\n.sayupper текст — ВЕРХНИЙ РЕГИСТР\n.saylower текст — нижний регистр\n"
            ".saytitle текст — Заглавные Буквы\n.sayclean текст — очистить пробелы\n"
            ".sayquote текст — оформить цитатой\n.saybullets строки — список\n"
            ".saylen текст — статистика текста\n.sayfind слово — поиск по личному архиву")

    def show_automation(self):
        self._show_text_dialog("Автоматизация",
            "Доступно сейчас:\n• Сокращения и шаблоны при отправке\n• Переменные {date} и {time}\n"
            "• Подпись в конце сообщения (по умолчанию выключена)\n• Очистка пробелов и заглавная буква — по настройке.\n\n"
            "Все изменения происходят только в твоём исходящем тексте. Автоматической рассылки нет.")

    def show_appearance(self):
        density = ["Компактная", "Обычная", "Подробная"]
        density_value = self.get_setting("dashboard_density", 1)
        index = int(1 if density_value is None else density_value)
        self._show_text_dialog("Внешний вид Telegram и SayPlugin",
            f"Стиль панели: {density[max(0, min(index, 2))]}\n"
            f"Иконки: {'включены' if self.get_setting('dashboard_emoji', True) else 'выключены'}\n"
            f"Описание панели: {'включено' if self.get_setting('dashboard_intro', True) else 'выключено'}\n"
            f"Цветовая тема Telegram: {'включена' if self.get_setting('telegram_theme_enabled', False) else 'выключена'}\n"
            f"Палитра: {['Океан', 'Мята', 'Роза', 'Фиолетовый', 'Графит'][max(0, min(int(self.get_setting('telegram_palette', 0) or 0), 4))]}\n\n"
            "Цветовой режим экспериментальный: меняет только распознанные Theme-ключи и зависит от версии клиента. Если оформление выглядит некорректно, выключи переключатель.")

    def show_utilities(self):
        self._show_text_dialog("Инструменты",
            "• .saydate — текущая дата\n• .saytime — текущее время\n• .saylen текст — символы, слова и строки\n"
            "• .sayclean текст — убрать лишние пробелы\n• .sayreverse текст — перевернуть текст\n"
            "• .sayquote текст — оформить цитатой\n• .saybullets строки — сделать список")

    def show_lab(self):
        self._show_text_dialog("Лаборатория",
            "Экспериментальные возможности будут включаться отдельно. Здесь появятся диагностика SDK, тесты совместимости и предварительный просмотр новых функций. Непроверенные изменения интерфейса Telegram не включаются автоматически.")

    def show_module_status(self):
        archive_count = len(safe_json_list(self.get_setting("archive_json", "[]")))
        shortcuts = parse_shortcuts(self.get_setting("shortcuts", DEFAULT_SHORTCUTS))
        templates = parse_shortcuts(self.get_setting("templates", ""))
        status = (
            "SayPlugin 0.5.1\n\n"
            f"Текстовый движок: {'вкл' if self.get_setting('macros_enabled', True) else 'выкл'}\n"
            f"Автосокращения: {'вкл' if self.get_setting('shortcuts_enabled', True) else 'выкл'} ({len(shortcuts) + len(templates)} ключей)\n"
            f"Личный архив: {'вкл' if self.get_setting('archive_enabled', True) else 'выкл'} ({archive_count} записей)\n"
            f"Очистка пробелов: {'вкл' if self.get_setting('clean_spaces', False) else 'выкл'}\n"
            f"Автозаглавная: {'вкл' if self.get_setting('capitalize_first', False) else 'выкл'}\n"
            f"Подпись: {'вкл' if self.get_setting('signature_enabled', False) else 'выкл'}\n\n"
            "Панель и текстовые функции используют документированные API SDK. Перекраска Telegram экспериментальная и требует проверки на конкретной сборке AyuGram."
        )
        self._show_text_dialog("SayPlugin · Диагностика", status)

    def show_about(self):
        self._show_text_dialog("О SayPlugin",
            "SayPlugin — модульный набор инструментов для AyuGram Android. Данные архива и настроек остаются в локальном хранилище плагина. Плагин не читает списки участников и не собирает чужие личные данные.")

    def help_text(self):
        return ("SayPlugin 0.5.1\nКоманды: .saydate, .saytime, .sayupper, .saylower, .saytitle, "
                ".sayclean, .sayreverse, .sayquote, .saybullets, .saylen.\n.sayfind слово — поиск в архиве; .sayarchive — открыть архив. Эти две команды выполняются локально.\n"
                "Открой SayPlugin в меню Telegram для доступа к разделам.")
